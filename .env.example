APP_NAME="Agenda Iwori"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=iwori_agenda
# Nunca use o usuario root da aplicacao; crie um usuario dedicado com senha forte.
# DB_USERNAME=iwori
# DB_PASSWORD=defina_uma_senha_forte
# Banco remoto com TLS: caminho do certificado CA. No TiDB Cloud (porta 4000),
# o pacote de CAs do sistema basta (Debian: /etc/ssl/certs/ca-certificates.crt).
# MYSQL_ATTR_SSL_CA=/caminho/para/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Em producao (HTTPS), mantenha SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Fotos de perfil e comprovantes: "local" (disco do servidor) ou "r2"
# (Cloudflare R2, para hospedagens com disco temporário, como o Render Free).
UPLOADS_DISK=local
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=iwori-uploads
# R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Envio real via Gmail: gere uma senha de app (conta com 2FA) e use:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=seuemail@gmail.com
# MAIL_PASSWORD=senha_de_app_de_16_caracteres
# MAIL_FROM_ADDRESS=seuemail@gmail.com

# Sincronização com o Google Calendar (OAuth 2.0).
# Crie as credenciais em https://console.cloud.google.com (Calendar API)
# com redirect URI: ${APP_URL}/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fuso em que os horários das sessões são digitados (padrão: Brasília).
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
# true depois que o Google aprovar a verificação do app (tira da página de
# ajuda o passo do aviso "O Google não verificou este app").
GOOGLE_APP_VERIFIED=false

# Cobrança via WhatsApp (Cloud API da Meta).
# Requer conta Meta Business, número dedicado e template aprovado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_CHARGE=cobranca_iwori
# Versão da Graph API (padrão v25.0); troque quando a Meta anunciar o fim dela.
# WHATSAPP_API_VERSION=v25.0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
